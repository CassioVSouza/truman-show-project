#!/bin/sh
# Blocks commits containing secrets. Enable once: git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed. Install it (https://github.com/gitleaks/gitleaks) before committing." >&2
  exit 1
fi
exec gitleaks protect --staged --redact --config .gitleaks.toml
